<?xml version="1.0"?>
<package format="3">
  <name>rasptank_hw</name>
  <version>0.1.0</version>
  <description>Nodos ROS 2 del hardware del RaspTank (motores, servos, sensores y cámara) con driver real (PCA9685, GPIO) o simulado.</description>
  <maintainer email="gbellido@mondragon.edu">gbellido</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rasptank_core</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>std_srvs</depend>
  <depend>rcl_interfaces</depend>
  <depend>python3-yaml</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
