<?xml version="1.0"?>
<package format="3">
  <name>rasptank_core</name>
  <version>0.1.0</version>
  <description>Librería común sin ROS del RaspTank: cinemática, odometría, brazo, geometría, visión y máquina de estados de la misión.</description>
  <maintainer email="gbellido@mondragon.edu">gbellido</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
