<?xml version="1.0"?>
<package format="3">
  <name>rasptank_sim</name>
  <version>0.1.0</version>
  <description>Simulador ligero del RaspTank: mundo 2D, ultrasonido, sensores de línea, cámara sintética y agarre del cubo.</description>
  <maintainer email="gbellido@mondragon.edu">gbellido</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rasptank_core</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-yaml</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
