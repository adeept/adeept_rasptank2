<?xml version="1.0"?>
<package format="3">
  <name>rasptank_perception</name>
  <version>0.1.0</version>
  <description>Detector del cubo (color o YOLO) y de la meta (ArUco) para el RaspTank.</description>
  <maintainer email="gbellido@mondragon.edu">gbellido</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rasptank_core</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>geometry_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
