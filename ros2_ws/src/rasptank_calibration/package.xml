<?xml version="1.0"?>
<package format="3">
  <name>rasptank_calibration</name>
  <version>0.1.0</version>
  <description>Calibración de la odometría del RaspTank: modo manual (cinta métrica) y automático (marcador ArUco), por línea de comandos o desde la app.</description>
  <maintainer email="gbellido@mondragon.edu">gbellido</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rasptank_core</depend>
  <depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>vision_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
